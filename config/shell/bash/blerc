# Viresta's ble.sh settings. Colors 0 to 15 come from the terminal, so they follow the
# dark and light themes.

# The prompt's arrow already turns red when a command fails.
bleopt exec_errexit_mark=

# No message or sound for keys ble.sh does not know.
bleopt decode_error_kseq_vbell=
bleopt decode_error_kseq_abell=

# Enter always runs the command, as in plain Bash, even after pasting several lines.
function blerc/emacs-load-hook {
    bleopt keymap_emacs_mode_string_multiline=
    ble-bind -f 'C-m' accept-line
    ble-bind -f 'RET' accept-line
    ble-bind -f 'S-RET' accept-line
}
blehook/eval-after-load keymap_emacs blerc/emacs-load-hook

# Suggestions
ble-face auto_complete='fg=8'

# Commands
ble-face -s syntax_command fg=2
ble-face -s command_builtin fg=2
ble-face -s command_alias fg=2
ble-face -s command_function fg=2
ble-face -s command_file fg=2
ble-face -s command_keyword fg=3

# Text
ble-face -s syntax_quoted fg=3
ble-face -s syntax_comment fg=8
ble-face -s syntax_error fg=1

# Files
ble-face -s filename_directory underline
ble-face -s filename_executable underline,fg=2
ble-face -s filename_link underline
